# MyFiat Assistant — local overrides.
#
# SHARED SECRETS (inference key, Twilio creds, ElevenLabs voice) are read from
# ../backend/.env automatically by the npm scripts. You usually DON'T repeat them
# here; this file is only for things that differ for the customer assistant.

# Text-chat + voice server port (must differ from the enterprise backend's 8080).
PORT=8072

# Where the MyFiat app's API lives (the sibling agent's service).
MYFIAT_API_URL=http://localhost:8071

# Public hostname Twilio can reach for the VOICE flow, without protocol.
# This service needs its OWN cloudflared tunnel to its PORT (separate from the
# enterprise backend's tunnel). e.g. abc123.trycloudflare.com
PUBLIC_HOST=

# Who the suspicious-charge call goes to by default.
DEMO_PHONE=+19132658472

# Overrides (normally inherited from ../backend/.env):
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# CHAT_MODEL=hackathon-chat
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_NUMBER=+19137046751
# TTS_PROVIDER=ElevenLabs
# TTS_VOICE=cjVigY5qzO86Huf0OWal
