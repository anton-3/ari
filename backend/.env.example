# npm scripts load ../.env then backend/.env (backend values override root).
# Variables already set in the shell win over both files. Remove unused blank
# overrides from backend/.env if you want values inherited from the root file.

PORT=8080
# Public hostname Twilio can reach, without protocol (e.g. abc123.trycloudflare.com)
PUBLIC_HOST=

TWILIO_SID=
TWILIO_AUTH_TOKEN=
# Optional: override the built-in caller ID / SMS sender numbers
TWILIO_NUMBER=
TWILIO_SMS_NUMBER=

# Inference: the workshop endpoint. Paste the team key from the organizers (starts with hk_).
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=

# Model names. These are the hackathon aliases. Change them only if you switch providers.
CHAT_MODEL=hackathon-chat
EMBEDDING_MODEL=hackathon-embedding
IMAGE_MODEL=hackathon-image
TEAM_ID=

# Object Storage: the storage lab or scripts/up.sh fills these in.
# Empty: the agent reads the files in docs/sample/ instead.
OBJ_ENDPOINT=
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=

# twilio: ConversationRelay manages STT/TTS. custom: self-hosted STT + Kokoro (voice-model node).
# custom-with-deepgram: Deepgram STT + Kokoro.
# Default is custom. Restart the backend to change the selected stack.
ARI_VOICE_STACK=custom
# ConversationRelay voice, also used for overflow and automatic fallback.
# Defaults: ElevenLabs / cjVigY5qzO86Huf0OWal (Eric); no ElevenLabs key required.
TTS_PROVIDER=
TTS_VOICE=
ELEVENLABS_KEY=
# Self-hosted STT (voice-stt/), only required in custom mode. On the voice-model node itself use
# ws://127.0.0.1:8001/v1/listen; elsewhere wss://<kokoro host>/v1/listen.
STT_URL=
STT_API_KEY=
STT_ENDPOINTING_MS=300
# Deepgram key, only required in custom-with-deepgram mode.
DEEPGRAM_API=
DEEPGRAM_MODEL=nova-3
# Direct TTS, only required in custom mode. FFmpeg must be on PATH.
KOKORO_TTS_API_KEY=
KOKORO_TTS_BASE_URL=
KOKORO_TTS_VOICE=af_heart
KOKORO_TTS_SPEED=1.0

# Linode API token (instance control for Ari)
LINODE_API_TOKEN=
