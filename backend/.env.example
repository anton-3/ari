# Loaded by the npm scripts from backend/.env first, then ../.env as a fallback
# (per variable). Variables already set in the shell win over both files.

PORT=8080
# Public hostname Twilio can reach, without protocol (e.g. abc123.trycloudflare.com)
PUBLIC_HOST=

TWILIO_SID=
TWILIO_AUTH_TOKEN=
# Optional: override the built-in caller ID / SMS sender numbers
TWILIO_NUMBER=
TWILIO_SMS_NUMBER=

# Inference: the workshop endpoint. Paste the team key from the organizers (starts with hk_).
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=

# Model names. These are the hackathon aliases. Change them only if you switch providers.
CHAT_MODEL=hackathon-chat
EMBEDDING_MODEL=hackathon-embedding
IMAGE_MODEL=hackathon-image
TEAM_ID=

# Object Storage: the storage lab or scripts/up.sh fills these in.
# Empty: the agent reads the files in docs/sample/ instead.
OBJ_ENDPOINT=
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=

# Voice for calls (ConversationRelay). Defaults: ElevenLabs / cjVigY5qzO86Huf0OWal (Eric)
TTS_PROVIDER=
TTS_VOICE=
ELEVENLABS_KEY=
KOKORO_TTS_API_KEY=
KOKORO_TTS_BASE_URL=

# Linode API token (instance control for Ari)
LINODE_API_TOKEN=
